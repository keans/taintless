  n2 -> n4 [label="exc" color="#7b1fa2" fontcolor="#7b1fa2" style=dashed];
  n2 -> n3 [];
  n4 -> n3 [];
  n3 -> n1 [label="return" color="#6d4c41" fontcolor="#6d4c41"];
